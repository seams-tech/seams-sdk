# Router A/B GitHub Environment template.
# Generate a complete lane generation (including its paired product manifest):
# pnpm wallet-core:deploy:env-prepare -- --lane staging-testnet
# pnpm wallet-core:deploy:env-prepare -- --lane production-testnet
# pnpm wallet-core:deploy:env-prepare -- --lane production-mainnet
# Apply the product manifest to its site with:
# pnpm product:deploy:env-apply -- --site staging --manifest-file <product-manifest>
# Copy these names into the matching split GitHub Environments.
# Do not source this file with real secrets.

# GitHub Environment variables.
# wallet-core:deploy:env-prepare generates the target-specific values.
ROUTER_AB_JWT_ISSUER=https://issuer.example
ROUTER_AB_JWT_AUDIENCE=router-ab
ROUTER_AB_JWT_JWKS_JSON={"keys":[{"alg":"EdDSA","crv":"Ed25519","kid":"example-router-key","kty":"OKP","use":"sig","x":"AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA"}]}
ROUTER_AB_DERIVER_A_ENVELOPE_HPKE_PUBLIC_KEY=x25519:<64-lowercase-hex>
ROUTER_AB_DERIVER_B_ENVELOPE_HPKE_PUBLIC_KEY=x25519:<64-lowercase-hex>
ROUTER_AB_SIGNING_WORKER_SERVER_OUTPUT_HPKE_PUBLIC_KEY=x25519:<64-lowercase-hex>
ROUTER_AB_DERIVER_A_PRIVATE_D1_ID=<cloudflare-d1-uuid>
ROUTER_AB_DERIVER_B_PRIVATE_D1_ID=<cloudflare-d1-uuid>
ROUTER_AB_DERIVER_A_ROLE_PRIVATE_D1_KEK_PUBLIC_KEY=x25519:<64-lowercase-hex>
ROUTER_AB_DERIVER_A_ROLE_PRIVATE_D1_KEK_VERSION=epoch-1
ROUTER_AB_DERIVER_B_ROLE_PRIVATE_D1_KEK_PUBLIC_KEY=x25519:<64-lowercase-hex>
ROUTER_AB_DERIVER_B_ROLE_PRIVATE_D1_KEK_VERSION=epoch-1
ROUTER_AB_SIGNING_WORKER_PRIVATE_D1_ID=<cloudflare-d1-uuid>
ROUTER_AB_SIGNING_WORKER_PRIVATE_D1_KEK_PUBLIC_KEY=x25519:<64-lowercase-hex>
ROUTER_AB_SIGNING_WORKER_PRIVATE_D1_KEK_VERSION=epoch-1
ROUTER_AB_DERIVER_A_PEER_VERIFYING_KEY_HEX=<64-lowercase-hex>
ROUTER_AB_DERIVER_B_PEER_VERIFYING_KEY_HEX=<64-lowercase-hex>
ROUTER_AB_PROJECT_POLICY_BOOTSTRAP_JSON=<json-object>

# GitHub Environment secrets.
# wallet-core:deploy:env-prepare generates all cryptographic values below.
CLOUDFLARE_API_TOKEN=<worker-deploy-token>
CLOUDFLARE_ACCOUNT_ID=<account-id>
ROUTER_AB_INTERNAL_SERVICE_AUTH_SECRET=router-ab-internal-service-auth-v1:<base64url>
DERIVER_A_ENVELOPE_HPKE_PRIVATE_KEY=hpke-x25519-private-v1:<64-lowercase-hex>
DERIVER_A_PEER_SIGNING_KEY=<32-byte-unpadded-base64url>
DERIVER_B_ENVELOPE_HPKE_PRIVATE_KEY=hpke-x25519-private-v1:<64-lowercase-hex>
DERIVER_B_PEER_SIGNING_KEY=<32-byte-unpadded-base64url>
DERIVER_A_ROLE_PRIVATE_D1_KEK=hpke-x25519-role-private-d1-private-v1:<64-lowercase-hex>
DERIVER_B_ROLE_PRIVATE_D1_KEK=hpke-x25519-role-private-d1-private-v1:<64-lowercase-hex>
SIGNING_WORKER_SERVER_OUTPUT_HPKE_PRIVATE_KEY=hpke-x25519-server-output-private-v1:<64-lowercase-hex>
SIGNING_WORKER_PRIVATE_D1_KEK=hpke-x25519-server-output-private-v1:<64-lowercase-hex>
