{
  "name": "@seams-internal/wallet-console-server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "files": [
    "dist",
    "migrations"
  ],
  "main": "./dist/esm/index.js",
  "types": "./dist/types/wallet-console-server-ts/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/wallet-console-server-ts/src/index.d.ts",
      "import": "./dist/esm/index.js",
      "default": "./dist/esm/index.js"
    },
    "./*": {
      "types": "./dist/types/wallet-console-server-ts/src/*.d.ts",
      "import": "./dist/esm/*.js",
      "default": "./dist/esm/*.js"
    }
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json && rm -rf dist/types/console-server-ts dist/types/wallet-server && rolldown -c rolldown.config.ts",
    "build:types": "tsc -p tsconfig.build.json",
    "type-check": "tsc --noEmit"
  },
  "dependencies": {
    "@aws-sdk/client-sesv2": "^3.1106.0",
    "@seams-internal/console-server": "workspace:*",
    "@seams-internal/console-shared": "workspace:*",
    "@seams-internal/wallet-console-shared": "workspace:*",
    "@seams/wallet-server": "workspace:*",
    "bs58": "^6.0.0",
    "express": "^4.21.2",
    "tslib": "^2.8.1"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "rolldown": "^1.0.0-beta.27",
    "typescript": "^5.8.3"
  }
}
