# Local Router API secrets template.
#
# Rename or copy this file to `packages/console-server-ts/.dev.vars`, then fill
# in the real values. Do not commit `.dev.vars`.

# Required for the local "Fund account" test button for implicit NEAR accounts.
RELAYER_ACCOUNT_ID=w3a-relayer.testnet
RELAYER_PRIVATE_KEY=ed25519:<fill-local-testnet-relayer-private-key>

# Local testnet funding settings.
NEAR_RPC_URL=https://test.rpc.fastnear.com
ACCOUNT_INITIAL_BALANCE=30000000000000000000000
ENABLE_IMPLICIT_NEAR_ACCOUNT_TEST_FUNDING=true

# Optional GitHub dashboard sign-in. Register this exact callback URL on the
# GitHub OAuth App, then set these values in `.dev.vars`.
# GITHUB_OAUTH_CLIENT_ID=
# GITHUB_OAUTH_CLIENT_SECRET=
# GITHUB_OAUTH_CALLBACK_URL=https://localhost/dashboard/login

# Optional override for sponsored NEAR execution pricing. The checked-in local
# Wrangler config supplies a deterministic test rate by default.
# SPONSORED_EXECUTION_STATIC_PRICING_JSON={"near":{"TESTNET":{"estimateFeeAmountYocto":"1000000000000000000000","minorPerFeeUnitNumerator":"300","minorPerFeeUnitDenominator":"1000000000000000000000000","pricingVersion":"static-near-testnet-local-v1"}}}

# Required for the Billing page to create real Stripe Checkout Sessions.
# Use a Stripe test-mode secret locally.
STRIPE_API_SK=sk_test_replace_me
STRIPE_WEBHOOK_SECRET=whsec_replace_me

# Optional Stripe Checkout configuration.
# STRIPE_API_BASE_URL=https://api.stripe.com
# STRIPE_API_TIMEOUT_MS=15000
