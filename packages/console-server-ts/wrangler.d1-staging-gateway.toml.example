name = "seams-sdk-d1-gateway-staging"
main = "../wallet-console-server-ts/src/router/cloudflare/d1GatewayWorker.ts"
compatibility_date = "2026-04-17"
compatibility_flags = ["nodejs_compat"]

[[d1_databases]]
binding = "SIGNER_DB"
database_name = "seams-signer-staging-nrt"
database_id = "<remote-signer-d1-database-id>"
migrations_dir = "node_modules/@seams/wallet-server/migrations/d1-signer"

[[services]]
binding = "WALLET_CONSOLE"
service = "seams-sdk-d1-console-staging"

[[services]]
binding = "SIGNING_WORKER"
service = "router-ab-signing-worker-staging"

[[services]]
binding = "MPC_ROUTER"
service = "router-ab-mpc-router-staging"

[vars]
SEAMS_TENANT_STORAGE_NAMESPACE = "seams-staging"
CONSOLE_BASE_URL = "https://<console-staging-host>"
CONSOLE_EMAIL_RUNTIME_PROFILE = "PRODUCTION"
CONSOLE_EMAIL_PROVIDER = "RESEND"
CONSOLE_EMAIL_INVITATION_SECRET_KEY_ID = "console-email-staging-r1"
CONSOLE_EMAIL_FROM = "Seams <notifications@<verified-email-domain>>"
CONSOLE_EMAIL_CRON_EXPRESSIONS = "*/5 * * * *"
SEAMS_STAGING_ORG_ID = "org_staging"
SEAMS_STAGING_PROJECT_ID = "project_staging"
SEAMS_STAGING_ENV_ID = "staging"
ROUTER_AB_NORMAL_SIGNING_WORKER_ID = "router-ab-signing-worker-staging"
ROUTER_AB_PREWARM_ENABLED = "true"
SIGNING_WORKER_ID = "router-ab-signing-worker-staging"
ROUTER_AB_CEREMONY_JWT_ISSUER = "https://<gateway-staging-host>"
ROUTER_AB_CEREMONY_JWT_AUDIENCE = "router-ab"
ROUTER_AB_CEREMONY_JWT_KEY_ID = "router-ab-ceremony-staging-r1"
LINKED_DEVICE_WEBAUTHN_RP_ID = "<wallet-staging-host>"
LINKED_DEVICE_WEBAUTHN_ORIGIN = "https://<app-staging-host>"
ROUTER_AB_ECDSA_REGISTRATION_TOPOLOGY_JSON = '{"routerId":"router-ab-mpc-router-staging","signerSet":{"signer_set_id":"router-ab-staging-signers-r1","policy":"all_2","signer_a":{"role":"signer_a","signer_id":"signer-a","key_epoch":"epoch-1"},"signer_b":{"role":"signer_b","signer_id":"signer-b","key_epoch":"epoch-1"},"selected_server":{"server_id":"router-ab-signing-worker-staging","key_epoch":"epoch-1","recipient_encryption_key":"x25519:<signing-worker-output-public-key>"}},"deriverRecipientKeys":{"deriver_a":{"role":"signer_a","key_epoch":"epoch-1","public_key":"x25519:<deriver-a-envelope-public-key>"},"deriver_b":{"role":"signer_b","key_epoch":"epoch-1","public_key":"x25519:<deriver-b-envelope-public-key>"}}}'
RELAYER_ACCOUNT_ID = "seams-relayer-staging.testnet"
RELAYER_PUBLIC_KEY = "ed25519:<staging-relayer-public-key>"
NEAR_RPC_URL = "https://test.rpc.fastnear.com"
ACCOUNT_INITIAL_BALANCE = "30000000000000000000000"
ENABLE_IMPLICIT_NEAR_ACCOUNT_TEST_FUNDING = "false"
RELAY_SESSION_ISSUER = "seams-gateway-staging"
RELAY_SESSION_AUDIENCE = "seams-wallet-session"
CONSOLE_SESSION_COOKIE_NAME = "seams-console-jwt"
CONSOLE_SESSION_ISSUER = "https://seams-gateway-staging.example/console"
CONSOLE_SESSION_AUDIENCE = "seams-console-session"
SPONSORED_EXECUTION_REAL_PRICING_JSON = '{"provider":"outlayer","nearRpcUrl":"https://free.rpc.fastnear.com","oracleContractId":"price-oracle.near","nearUsdPriceId":"c415de8d2efa7db216527dff4b60e8f3a5311c740dadb233e13e12547e226750","maxAgeSeconds":120,"maxLatestToEmaDeviationBps":1000,"cacheTtlMs":60000,"near":{"TESTNET":{"nativeUnitDecimals":24,"estimateFeeAmountYocto":"1000000000000000000000","pricingVersionPrefix":"outlayer-near-testnet"}}}'
SPONSORED_EXECUTION_STATIC_PRICING_JSON = '{"near":{"TESTNET":{"estimateFeeAmountYocto":"1000000000000000000000","minorPerFeeUnitNumerator":"300","minorPerFeeUnitDenominator":"1000000000000000000000000","pricingVersion":"static-near-testnet-v1"}}}'

[triggers]
crons = ["* * * * *"]

[secrets]
required = [
  "CONSOLE_SESSION_HMAC_SECRET",
  "ACCOUNT_ID_DERIVATION_SECRET",
  "ROUTER_AB_INTERNAL_SERVICE_AUTH_SECRET",
  "LINKED_DEVICE_OPERATOR_RECOVERY_SECRET",
  "LINKED_DEVICE_TARGET_DESCRIPTOR_HMAC_SECRET",
  "ROUTER_AB_CEREMONY_JWT_PRIVATE_JWK",
  "RELAYER_PRIVATE_KEY",
  "SPONSORED_EVM_EXECUTORS_JSON",
  "STRIPE_API_SK",
  "STRIPE_WEBHOOK_SECRET",
  "RESEND_API_KEY",
  "CONSOLE_EMAIL_INVITATION_SECRET_KEY_B64U",
]
