{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "types": ["vite/client", "react", "react-dom"],
    "baseUrl": ".",
    "paths": {
      "@seams/sdk": ["../../packages/sdk-web/dist/types/sdk-web/src/index.d.ts"],
      "@seams/sdk/*": ["../../packages/sdk-web/dist/types/sdk-web/src/*"]
    }
  },
  "include": [
    "src/.vitepress/**/*.ts",
    "src/examples/**/*.ts",
    "src/examples/**/*.tsx",
    "vite-env.d.ts"
  ]
}
