{
  "schemaVersion": 1,
  "publicSdkVersion": "0.46.0",
  "commonPaths": [
    ".editorconfig",
    ".gitignore",
    ".prettierignore",
    ".prettierrc.json",
    "rustfmt.toml"
  ],
  "repositories": {
    "seams-wallet-sdk": {
      "visibility": "public",
      "sourcePaths": [
        ".cargo",
        "apps/docs",
        "benchmarks",
        "crates",
        "examples/self-host-cloudflare-worker",
        "justfile",
        "packages/wallet-server",
        "packages/wallet",
        "packages/shared-ts",
        "tools",
        "voiceId",
        "wasm"
      ],
      "excludePaths": [
        "crates/router-ab-cloudflare/env/deployment-values.example.env",
        "crates/router-ab-cloudflare/scripts/apply-github-external-values.mjs",
        "crates/router-ab-cloudflare/scripts/generate-github-env-values.mjs",
        "crates/router-ab-dev/README.md",
        "crates/router-ab-dev/scripts",
        "tools/ed25519-yao-generator/artifact-fs-policy/target"
      ],
      "workspacePackages": [
        "apps/docs",
        "crates/ed25519-yao-cloudflare-bench",
        "crates/router-ab-cloudflare",
        "examples/self-host-cloudflare-worker",
        "packages/wallet-server",
        "packages/wallet",
        "packages/shared-ts",
        "voiceId"
