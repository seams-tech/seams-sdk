        "apps/seams-site",
        "apps/web-server",
        "crates/router-ab-cloudflare/env/deployment-values.example.env",
        "crates/router-ab-cloudflare/scripts/apply-github-external-values.mjs",
        "crates/router-ab-cloudflare/scripts/generate-github-env-values.mjs",
        "crates/router-ab-dev/README.md",
        "crates/router-ab-dev/scripts",
        "deployment",
        "docs/deployment",
        "docs/refactor-103-console.md",
        "docs/saas",
        "packages/console-server-ts",
        "packages/console-shared-ts",
        "scripts/deploy-backend.mjs",
        "scripts/deploy-frontend.mjs",
        "scripts/deployment-smoke.mjs",
        "scripts/deployment-targets.mjs",
        "scripts/migration-fingerprint.mjs"
